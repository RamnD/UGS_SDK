+++ b/.github/workflows/unity-smoke.yml
@@ -0,0 +1,105 @@
+name: Unity smoke
+
+on:
+  pull_request:
+    branches: [agent/jules, staging, main]
+  push:
+    branches: [agent/jules, staging, main, feature/unity-cloud-smoke-tests]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: unity-smoke-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  layout:
+    name: Smoke project layout
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+        with:
+          ref: ${{ github.event.pull_request.head.sha || github.sha }}
+          persist-credentials: false
+      - run: python3 tests/unity-smoke/validate-project.py
+
+  unity:
+    name: Unity EditMode and PlayMode
+    needs: layout
+    # License credentials are available only for trusted same-repository branches.
+    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    permissions:
+      contents: read
+      checks: write
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+        with:
+          ref: ${{ github.event.pull_request.head.sha || github.sha }}
+          persist-credentials: false
+
+      - name: Validate Unity license configuration
+        shell: bash
+        env:
+          UNITY_LICENSE: ${{ secrets.UNITY_LICENSE }}
+          UNITY_EMAIL: ${{ secrets.UNITY_EMAIL }}
+          UNITY_PASSWORD: ${{ secrets.UNITY_PASSWORD }}
+          UNITY_SERIAL: ${{ secrets.UNITY_SERIAL }}
+          UNITY_LICENSING_SERVER: ${{ secrets.UNITY_LICENSING_SERVER }}
+        run: |
+          set -euo pipefail
+          if [[ -n "${UNITY_LICENSING_SERVER}" ]]; then
+            exit 0
+          fi
+          if [[ -z "${UNITY_EMAIL}" || -z "${UNITY_PASSWORD}" ]]; then
+            echo "::error::Configure Unity CI activation secrets. See TestProject/README.md; local SDK installation is not required."
+            exit 1
+          fi
+          if [[ -z "${UNITY_SERIAL}" && -z "${UNITY_LICENSE}" ]]; then
+            echo "::error::Set UNITY_SERIAL for a supported paid license, UNITY_LICENSE for a supported license file, or UNITY_LICENSING_SERVER. Missing activation is a failure, not a passed test."
+            exit 1
+          fi
+
+      - uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
+        with:
+          path: TestProject/Library
+          key: unity-smoke-${{ runner.os }}-6000.3.8f1-${{ hashFiles('TestProject/Assets/**', 'TestProject/Packages/**', 'TestProject/ProjectSettings/**', 'packages/**') }}
+          restore-keys: unity-smoke-${{ runner.os }}-6000.3.8f1-
+
+      - name: Run Unity tests
+        id: tests
+        uses: game-ci/unity-test-runner@32e57712352b500e17974b245a6dce9e11a73213 # v4
+        env:
+          UNITY_LICENSE: ${{ secrets.UNITY_LICENSE }}
+          UNITY_EMAIL: ${{ secrets.UNITY_EMAIL }}
+          UNITY_PASSWORD: ${{ secrets.UNITY_PASSWORD }}
+          UNITY_SERIAL: ${{ secrets.UNITY_SERIAL }}
+        with:
+          cliVersion: v0.1.72
+          projectPath: TestProject
+          testMode: all
+          coverageEnabled: false
+          artifactsPath: artifacts/unity-smoke
+          githubToken: ${{ github.token }}
+          checkName: Unity smoke test results
+          unityLicensingServer: ${{ secrets.UNITY_LICENSING_SERVER }}
+
+      - name: Require actual EditMode and PlayMode results
+        if: always() && !cancelled() && steps.tests.outcome != 'skipped'
+        shell: bash
+        run: python3 tests/unity-smoke/verify-results.py artifacts/unity-smoke >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Upload Unity results and logs
+        if: always() && !cancelled()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
+        with:
+          name: unity-smoke-${{ github.event.pull_request.head.sha || github.sha }}
+          path: |
+            artifacts/unity-smoke
+            TestProject/Logs
+          if-no-files-found: warn
+          retention-days: 14
