new file mode 100644
index 0000000..1a557b3
--- /dev/null
+++ b/tests/unity-smoke/validate-project.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""Validate the committed smoke project without installing Unity."""
+import json
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+PROJECT = ROOT / "TestProject"
+manifest = json.loads((PROJECT / "Packages/manifest.json").read_text())
+packages = {
+    "com.ramnd.gameservices-sdk": "gameservices-sdk",
+    "com.ramnd.core-logging": "core-logging",
+    "com.ramnd.service-fault": "service-fault",
+    "com.ramnd.gameservices-servicefault": "gameservices-servicefault",
+}
+for name, folder in packages.items():
+    value = manifest["dependencies"][name]
+    assert value == "file:../../packages/" + folder, (name, value)
+    package = (PROJECT / "Packages" / value.removeprefix("file:")).resolve()
+    assert package == ROOT / "packages" / folder
+    assert json.loads((package / "package.json").read_text())["name"] == name
+assert "com.ramnd.gameservices-sdk" in manifest["testables"]
+assert re.fullmatch(r"m_EditorVersion: \d+\.\d+\.\d+f\d+\n?", (PROJECT / "ProjectSettings/ProjectVersion.txt").read_text())
+
+guids = {}
+assets = PROJECT / "Assets"
+for path in assets.rglob("*"):
+    if path.suffix == ".meta":
+        continue
+    meta = path.with_name(path.name + ".meta")
+    assert meta.is_file(), f"Missing {meta}"
+    match = re.search(r"^guid: ([0-9a-f]{32})$", meta.read_text(), re.M)
+    assert match, meta
+    guid = match[1]
+    assert guid not in guids, f"Duplicate GUID: {guid}"
+    guids[guid] = path
+for meta in assets.rglob("*.meta"):
+    assert meta.with_suffix("").exists(), f"Orphan meta: {meta}"
+for path in assets.rglob("*.asmdef"):
+    json.loads(path.read_text())
+scene = assets / "Scenes/SdkSmoke.unity"
+bootstrap_meta = assets / "Smoke/SdkSmokeBootstrap.cs.meta"
+bootstrap_guid = re.search(r"^guid: ([0-9a-f]{32})$", bootstrap_meta.read_text(), re.M)[1]
+assert "guid: " + bootstrap_guid in scene.read_text()
+scene_guid = re.search(r"^guid: ([0-9a-f]{32})$", scene.with_suffix(".unity.meta").read_text(), re.M)[1]
+build_settings = (PROJECT / "ProjectSettings/EditorBuildSettings.asset").read_text()
+assert "Assets/Scenes/SdkSmoke.unity" in build_settings and scene_guid in build_settings
+assert "productName: UGS SDK Smoke Tests" in (PROJECT / "ProjectSettings/ProjectSettings.asset").read_text()
+assert not list((ROOT / "packages").glob("*/TestProject"))
+print("Smoke project layout, local package bindings, scene references and asset metadata are valid.")
diff --git a/tests/unity-smoke/verify-results.py b/tests/unity-smoke/verify-results.py
new file mode 100644
index 0000000..da3ef6e
--- /dev/null
+++ b/tests/unity-smoke/verify-results.py
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Reject missing, empty, failed or incomplete Unity test reports."""
+import sys
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+SMOKE_TESTS = {
+    "SmokeScene_BootstrapsAndSendsEvent",
+    "PeriodicFlush_SendsWithoutExplicitFlush",
+    "TransientFailure_AutomaticallyRetriesSameEnvelope",
+    "PendingEvent_SurvivesDisposeAndRecreation",
+}
+
+
+def verify(directory):
+    cases = []
+    failures = []
+    for path in sorted(Path(directory).rglob("*.xml")):
+        root = ET.parse(path).getroot()
+        if root.tag not in ("test-run", "test-results"):
+            continue
+        cases.extend(root.iter("test-case"))
+        if root.get("result") in ("Failed", "Failure", "Cancelled") or int(root.get("failed", "0")) > 0:
+            failures.append(str(path))
+    if not cases:
+        raise ValueError("No Unity test cases were reported. Import, compilation or licensing may have failed.")
+    smoke = {case.get("name") for case in cases if case.get("fullname", "").startswith("AnalyticsSmokeTests.") and case.get("result") == "Passed"}
+    missing = SMOKE_TESTS - smoke
+    if missing:
+        raise ValueError("Missing or unsuccessful PlayMode scenarios: " + ", ".join(sorted(missing)))
+    editor = [case for case in cases if case.get("fullname", "").startswith("RamndAnalyticsTests.") and case.get("result") == "Passed"]
+    if not editor:
+        raise ValueError("Existing SDK EditMode tests were not executed successfully. Check manifest testables.")
+    failed_cases = [case.get("fullname", case.get("name", "unknown")) for case in cases if case.get("result") not in ("Passed", "Skipped", "Ignored", "Inconclusive")]
+    if failures or failed_cases:
+        raise ValueError("Unity test failures: " + ", ".join(failures + failed_cases))
+    print("### Unity smoke results\n")
+    print(f"Passed all {len(SMOKE_TESTS)} required PlayMode scenarios and {len(editor)} SDK EditMode tests.")
+    print(f"Total reported test cases: {len(cases)}. See the unity-smoke artifact for XML results and logs.")
+
+
+if __name__ == "__main__":
+    try:
+        verify(sys.argv[1])
+    except (ValueError, OSError, ET.ParseError) as error:
+        print(f"Unity result validation failed: {error}", file=sys.stderr)
+        sys.exit(1)
