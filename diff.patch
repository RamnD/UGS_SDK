diff --git a/TestProject/Assets/Tests/PlayMode/AnalyticsSmokeTests.cs b/TestProject/Assets/Tests/PlayMode/AnalyticsSmokeTests.cs
new file mode 100644
index 0000000..b95fa66
--- /dev/null
